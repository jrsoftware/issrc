    (English: 'Are you sure you want to remove your commercial license key and revert to non-commercial use only?'; Localized: '¿Está seguro de que desea quitar su clave de licencia comercial y volver al uso exclusivamente no comercial?'),
    (English: 'Commercial license key has been removed.'; Localized: 'Se ha quitado la clave de licencia comercial.'),
    (English: 'Your version of Inno Setup has been updated! <a id="%1">See what''s new</a>.'; Localized: '¡Su versión de Inno Setup se ha actualizado! <a id="%1">Vea las novedades</a>.'),
    (English: 'VS Code-style editor shortcuts added! Use the <a id="%1">Editor Keys option</a> in Options dialog.'; Localized: '¡Se agregaron métodos abreviados de teclado del editor al estilo de VS Code! Use la <a id="%1">opción Teclas del editor</a> en el diálogo Opciones.'),
    (English: 'RTF Editor added, a built-in WordPad replacement! Use the <a id="%1">RTF Editor item</a> in Tools menu.'; Localized: '¡Se agregó el Editor RTF, un sustituto integrado de WordPad! Use el <a id="%1">elemento Editor RTF</a> en el menú Herramientas.'),
    (English: 'Inno Setup Compiler is available in your language! Use the <a id="%1">Language option</a> in Options dialog.'; Localized: '¡Inno Setup Compiler está disponible en su idioma! Use la <a id="%1">opción Idioma</a> en el diálogo Opciones.'),
    (English: '<a id="%1">Ideas board is open!</a> Share your ideas and vote on others, this month only.'; Localized: '<a id="%1">¡El tablero de ideas está abierto!</a> Comparta sus ideas y vote las de otros, solo este mes.'),
    (English: 'Running a version released after your update entitlement ended. <a id="%1">Renew license</a>, <a id="%2">remove key</a>, or <a id="%3">exit</a>.'; Localized: 'Está ejecutando una versión publicada después del fin de su derecho a actualizaciones. <a id="%1">Renovar licencia</a>, <a id="%2">quitar clave</a> o <a id="%3">salir</a>.'),
    (English: 'Your update entitlement is ending soon. Please <a id="%1">renew your license</a>. Thanks!'; Localized: 'Su derecho a actualizaciones terminará pronto. Por favor, <a id="%1">renueve su licencia</a>. ¡Gracias!'),
